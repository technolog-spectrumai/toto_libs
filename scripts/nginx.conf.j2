# Redirect all HTTP traffic to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ domain }};

    return 301 https://$host$request_uri;
}

# HTTPS server for Django app
server {
    listen 443 ssl;
    http2 on;
    server_name {{ domain }};

    # SSL certificate
    ssl_certificate /etc/nginx/cert/{{ ssl_cert }};
    ssl_certificate_key /etc/nginx/cert/{{ ssl_key }};

    # SSL settings
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header Referrer-Policy "strict-origin";
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline' 'unsafe-eval';";

    # Proxy to Django app
    location / {
        proxy_pass http://{{ upstream_host }}:{{ upstream_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static files
    location /static/ {
        alias /staticfiles/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
    }

    # Vault bytes are NOT web-served. This block is the second half of the fix
    # in toto/vault/storage.py, and both halves are load-bearing: the storage
    # stops anything MINTING a /media/vault/ link, and this stops nginx honouring
    # one that already exists in somebody's history or bookmark.
    #
    # It used to be served with `Cache-Control: public` and no auth, so
    # /media/vault/files/<name> returned anybody's file to anybody — and the
    # name is guessable, because Django only suffixes a filename on collision.
    # Every permission check in the platform was bypassable by typing a URL.
    #
    # Reading a vault file goes through vault:public_file, which asks
    # toto.vault.access.may_read first.
    location /media/vault/ {
        return 404;
    }

    # Everything else under media/ — avatars, logos, the things that really are
    # public — stays as it was.
    location /media/ {
        alias /mediafiles/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
    }

    # Block hidden files
    location ~ /\.ht {
        deny all;
    }

    location /metrics {
        proxy_pass http://{{ upstream_host }}:{{ upstream_port }}/metrics;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
