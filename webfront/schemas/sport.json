{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyLandingPageConfig",
  "type": "object",
  "properties": {
    "company_name": { "type": "string" },
    "company_description": { "type": "string" },
    "company_address": { "type": "string" },
    "company_email": { "type": "string", "format": "email" },
    "company_phone": { "type": "string" },
    "company_group_link": { "type": "string", "format": "uri" },
    "copyright": { "type": "string" },

    "quick_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 3
    },

    "hero": {
      "type": "object",
      "properties": {
        "image_url": { "type": "string", "format": "uri" },
        "image_alt": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "cta_text": { "type": "string" },
        "cta_link": { "type": "string", "format": "uri" }
      },
      "required": ["image_url", "image_alt", "title", "description", "cta_text", "cta_link"]
    },

    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["title", "description"]
      },
      "minItems": 3,
      "maxItems": 3
    },

    "platform": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5
        },
        "tech_stack": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": ["description", "features", "tech_stack"]
    },

    "insights": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5
        },
        "coming_soon": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["title", "description", "features", "coming_soon"]
    },

    "social_links": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "company_name",
    "company_description",
    "company_address",
    "company_email",
    "company_phone",
    "company_group_link",
    "copyright",
    "quick_links",
    "hero",
    "features",
    "platform",
    "insights",
    "social_links"
  ]
}